{
  "name": "Church Portal (Flutter + Firebase)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "FLUTTER_ROOT": "/home/vscode/flutter",
    "PUB_CACHE": "/home/vscode/.pub-cache"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/flutter/bin:/home/vscode/.pub-cache/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080, 4000, 8085, 9099],
  "portsAttributes": {
    "8080": { "label": "Flutter web-server", "onAutoForward": "openBrowser" },
    "4000": { "label": "Firebase Emulator UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "toba.vsfire",
        "github.vscode-github-actions"
      ],
      "settings": {
        "dart.flutterSdkPath": "/home/vscode/flutter",
        "editor.formatOnSave": true,
        "[dart]": { "editor.rulers": [120] }
      }
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}
