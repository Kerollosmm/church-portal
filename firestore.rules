rules_version = '2';

// Church portal — Firestore security rules.
// * Public content (incl. settings/church and settings/features): anyone can
//   read; only admins (admins/{uid} exists) write. Every write is validated:
//   a per-collection key allow-list (creates may use only these keys; updates
//   may only change these keys, so legacy fields never block an edit) plus
//   type/size checks on the stored document.
// * media/{mediaId}: optional images stored inline as base64 (Spark plan has
//   no Cloud Storage). Public read; admins write; size/type validated.
// * contact_messages: public create-only with strict validation; admins can
//   read them, mark them handled and delete them.
// * admins: a signed-in user reads their own doc; owners read all and add,
//   re-role or remove OTHER admins (never themselves, so an owner always
//   remains). Roles: 'owner' | 'editor' (missing role = editor).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'owner';
    }

    // ---- field helpers (absent or null is accepted for optional fields) ----
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    // Cheaper variant for docs with many text fields (absent = ''; null rejected).
    function str(d, k, max) {
      return d.get(k, '') is string && d.get(k, '').size() <= max;
    }
    function reqString(d, k, max) {
      return k in d && d[k] is string && d[k].size() >= 1 && d[k].size() <= max;
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function optInt(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }
    function optNumber(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }
    function optTimestamp(d, k) {
      return !(k in d) || d[k] == null || d[k] is timestamp;
    }
    function optTime(d, k) {
      return !(k in d) || d[k] == null || d[k] == '' || (d[k] is string && d[k].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function optList(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= max);
    }
    function optIn(d, k, values) {
      return !(k in d) || d[k] == null || d[k] in values;
    }

    // updatedAt / updatedBy (shown in the dashboard) are either untouched or
    // stamped now by the signed-in admin (email, or uid when there is none).
    function stampOk(d) {
      return (!('updatedAt' in d) || d.updatedAt == request.time
              || (resource != null && resource.data.get('updatedAt', null) == d.updatedAt))
        && (!('updatedBy' in d) || d.updatedBy == request.auth.token.get('email', request.auth.uid)
              || (resource != null && resource.data.get('updatedBy', null) == d.updatedBy));
    }

    // Shared by every content document.
    function common(d) {
      return d.keys().size() <= 60
        && optBool(d, 'visible') && optBool(d, 'sample')
        && optInt(d, 'order', -100000, 100000)
        && (d.get('image', null) == null || validImage(d.image))
        && stampOk(d);
    }

    // Optional `image` map (only collections whose allow-list has 'image').
    // url/storage: an https URL; inline: a media/{mediaId} document id.
    function validImage(i) {
      return i is map && i.keys().hasOnly(['source', 'url', 'mediaId', 'alt', 'w', 'h'])
        && i.get('source', '') in ['url', 'inline', 'storage']
        && (i.source == 'inline'
              ? i.get('mediaId', '') is string && i.get('mediaId', '').matches('^[A-Za-z0-9_-]{1,128}$')
              : i.get('url', '') is string && i.get('url', '').size() <= 500 && i.get('url', '').matches('^https://[^/\\s]+[.][^/\\s]+([/?#][^\\s]*)?$'))
        && str(i, 'alt', 300) && str(i, 'mediaId', 128)
        && optInt(i, 'w', 1, 10000) && optInt(i, 'h', 1, 10000);
    }
    function meta() {
      return ['visible', 'sample', 'order', 'updatedAt', 'updatedBy'];
    }

    // Creates may use only [allowed]; updates may only change [allowed].
    function keysAllowed(allowed) {
      return resource == null
        ? request.resource.data.keys().hasOnly(allowed)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ------------------------------- content -------------------------------
    function validContent(col, d) {
      return col in ['alerts', 'seasons', 'liturgies', 'meetings', 'activities', 'clinics', 'facilities',
                     'priests', 'milestones', 'saints']
        && common(d) && (
        (col == 'alerts' && validAlert(d))
        || (col == 'seasons' && validSeason(d))
        || (col == 'liturgies' && validLiturgy(d))
        || (col == 'meetings' && validMeeting(d))
        || (col == 'activities' && validActivity(d))
        || (col == 'clinics' && validClinic(d))
        || (col == 'facilities' && validFacility(d))
        || (col == 'priests' && validPriest(d))
        || (col == 'milestones' && validMilestone(d))
        || (col == 'saints' && validSaint(d))
      );
    }

    function validAlert(d) {
      return keysAllowed(['titleAr', 'titleEn', 'bodyAr', 'bodyEn', 'active', 'startsAt', 'endsAt', 'priority', 'link',
                          'image'].concat(meta()))
        && reqString(d, 'titleAr', 300) && optString(d, 'titleEn', 300)
        && optString(d, 'bodyAr', 2000) && optString(d, 'bodyEn', 2000)
        && optBool(d, 'active') && optTimestamp(d, 'startsAt') && optTimestamp(d, 'endsAt')
        && optInt(d, 'priority', 0, 1000) && optString(d, 'link', 500);
    }

    function validSeason(d) {
      return keysAllowed(['key', 'nameAr', 'nameEn', 'startsAt', 'endsAt', 'active', 'image'].concat(meta()))
        && d.key in ['holy_week', 'pascha', 'nativity', 'revival_maximus', 'revival_moses', 'summer']
        && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optTimestamp(d, 'startsAt') && optTimestamp(d, 'endsAt') && optBool(d, 'active');
    }

    function validLiturgy(d) {
      return keysAllowed(['type', 'nameAr', 'nameEn', 'weekday', 'date', 'start', 'end', 'placeAr', 'placeEn',
                          'audienceAr', 'audienceEn', 'seasonKey'].concat(meta()))
        && optIn(d, 'type', ['mass', 'vespers', 'praise', 'other'])
        && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optInt(d, 'weekday', 1, 7) && optTimestamp(d, 'date')
        && 'start' in d && d.start is string && optTime(d, 'start') && optTime(d, 'end')
        && optString(d, 'placeAr', 300) && optString(d, 'placeEn', 300)
        && optString(d, 'audienceAr', 300) && optString(d, 'audienceEn', 300)
        && optIn(d, 'seasonKey', ['holy_week', 'pascha', 'nativity', 'revival_maximus', 'revival_moses', 'summer']);
    }

    function validMeeting(d) {
      return keysAllowed(['stage', 'nameAr', 'nameEn', 'weekday', 'start', 'end', 'hallAr', 'hallEn',
                          'facebookUrl', 'whatsappUrl', 'notes'].concat(meta()))
        && reqString(d, 'stage', 40) && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optInt(d, 'weekday', 1, 7) && optTime(d, 'start') && optTime(d, 'end')
        && optString(d, 'hallAr', 300) && optString(d, 'hallEn', 300)
        && optString(d, 'facebookUrl', 500) && optString(d, 'whatsappUrl', 500) && optString(d, 'notes', 300);
    }

    function validActivity(d) {
      return keysAllowed(['category', 'titleAr', 'titleEn', 'descAr', 'descEn', 'scheduleAr', 'scheduleEn',
                          'ageRange', 'contactPhone', 'link', 'image'].concat(meta()))
        && optString(d, 'category', 40) && reqString(d, 'titleAr', 300) && optString(d, 'titleEn', 300)
        && optString(d, 'descAr', 2000) && optString(d, 'descEn', 2000)
        && optString(d, 'scheduleAr', 300) && optString(d, 'scheduleEn', 300)
        && optString(d, 'ageRange', 60) && optString(d, 'contactPhone', 20) && optString(d, 'link', 500);
    }

    function validClinic(d) {
      return keysAllowed(['specialty', 'specialtyAr', 'specialtyEn', 'doctorName', 'degreeAr', 'degreeEn', 'days',
                          'start', 'end', 'bookingPhone', 'whatsapp', 'active'].concat(meta()))
        && reqString(d, 'specialty', 40) && reqString(d, 'specialtyAr', 300) && optString(d, 'specialtyEn', 300)
        && reqString(d, 'doctorName', 300) && optString(d, 'degreeAr', 300) && optString(d, 'degreeEn', 300)
        && optList(d, 'days', 7) && d.get('days', []).hasOnly([1, 2, 3, 4, 5, 6, 7])
        && optTime(d, 'start') && optTime(d, 'end')
        && optString(d, 'bookingPhone', 20) && optString(d, 'whatsapp', 20) && optBool(d, 'active');
    }

    function validFacility(d) {
      return keysAllowed(['type', 'nameAr', 'nameEn', 'descAr', 'descEn', 'phone', 'hoursAr', 'hoursEn'].concat(meta()))
        && optString(d, 'type', 40) && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optString(d, 'descAr', 2000) && optString(d, 'descEn', 2000) && optString(d, 'phone', 20)
        && optString(d, 'hoursAr', 300) && optString(d, 'hoursEn', 300);
    }

    function validPriest(d) {
      return keysAllowed(['name', 'nameEn', 'photoUrl', 'rank', 'ordinationDate', 'hegumenDate', 'departedDate',
                          'status', 'bioAr', 'bioEn', 'image'].concat(meta()))
        && reqString(d, 'name', 300) && optString(d, 'nameEn', 300) && optString(d, 'photoUrl', 500)
        && optIn(d, 'rank', ['hegumen', 'priest']) && optIn(d, 'status', ['serving', 'departed'])
        && optString(d, 'ordinationDate', 10) && optString(d, 'hegumenDate', 10) && optString(d, 'departedDate', 10)
        && optString(d, 'bioAr', 5000) && optString(d, 'bioEn', 5000);
    }

    function validMilestone(d) {
      return keysAllowed(['titleAr', 'titleEn', 'descAr', 'descEn', 'year', 'icon', 'image'].concat(meta()))
        && reqString(d, 'titleAr', 300) && optString(d, 'titleEn', 300)
        && optString(d, 'descAr', 2000) && optString(d, 'descEn', 2000)
        && optInt(d, 'year', 1, 2200) && optString(d, 'icon', 40);
    }

    function validSaint(d) {
      return keysAllowed(['nameAr', 'nameEn', 'bioAr', 'bioEn', 'feastCopticAr', 'feastCopticEn', 'feastGregorian',
                          'feastGregorianAr', 'image'].concat(meta()))
        && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optString(d, 'bioAr', 5000) && optString(d, 'bioEn', 5000)
        && optString(d, 'feastCopticAr', 300) && optString(d, 'feastCopticEn', 300)
        && optString(d, 'feastGregorian', 300) && optString(d, 'feastGregorianAr', 300);
    }

    match /{col}/{docId} {
      allow read: if col in ['alerts', 'seasons', 'liturgies', 'meetings', 'activities',
                             'clinics', 'facilities', 'priests', 'milestones', 'saints'];
      allow create, update: if isAdmin() && validContent(col, request.resource.data);
      allow delete: if isAdmin() && col in ['alerts', 'seasons', 'liturgies', 'meetings', 'activities',
                                            'clinics', 'facilities', 'priests', 'milestones', 'saints'];
    }

    // ------------------------------- settings -------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((docId == 'church' && validChurch(request.resource.data))
            || (docId == 'features' && validFeatures(request.resource.data)));
      allow delete: if false;
    }

    function validChurch(d) {
      return keysAllowed(['nameAr', 'nameEn', 'addressAr', 'addressEn', 'transportAr', 'transportEn', 'lat', 'lng',
                          'coordinatesApproximate', 'mapsUrl', 'mapsQuery', 'phones', 'whatsapp', 'whatsappChannel',
                          'facebook', 'youtube', 'instagram', 'verseAr', 'verseEn', 'verseRef', 'verseRefAr',
                          'heroImageUrl', 'historyAr', 'historyEn', 'bishopAr', 'bishopEn', 'altars',
                          'assistantEnabled', 'sample', 'updatedAt', 'updatedBy'])
        && reqString(d, 'nameAr', 300) && str(d, 'nameEn', 300)
        && str(d, 'addressAr', 300) && str(d, 'addressEn', 300)
        && str(d, 'transportAr', 2000) && str(d, 'transportEn', 2000)
        && optNumber(d, 'lat', -90, 90) && optNumber(d, 'lng', -180, 180)
        && str(d, 'mapsUrl', 500) && str(d, 'mapsQuery', 200)
        && d.get('phones', []) is list && d.get('phones', []).size() <= 20
        && d.get('altars', []) is list && d.get('altars', []).size() <= 20
        && str(d, 'whatsapp', 20) && str(d, 'whatsappChannel', 500) && str(d, 'facebook', 500)
        && str(d, 'youtube', 500) && str(d, 'instagram', 500)
        && str(d, 'verseAr', 300) && str(d, 'verseEn', 300)
        && str(d, 'verseRef', 60) && str(d, 'verseRefAr', 60) && str(d, 'heroImageUrl', 500)
        && str(d, 'historyAr', 8000) && str(d, 'historyEn', 8000)
        && str(d, 'bishopAr', 300) && str(d, 'bishopEn', 300)
        && d.get('assistantEnabled', false) is bool && d.get('sample', false) is bool
        && stampOk(d);
    }

    function sectionKeys() {
      return ['schedule', 'meetings', 'clinics', 'services', 'history', 'milestones', 'saints', 'priests',
              'departedPriests', 'activities', 'alerts', 'contactInfo', 'socials', 'contactForm', 'assistant', 'media'];
    }

    // Known section keys only, and every value a bool.
    function validSections(s) {
      return s is map && s.keys().hasOnly(sectionKeys()) && s.values().hasOnly([true, false]);
    }

    function validFeatures(d) {
      return d.keys().hasOnly(['sections', 'homeOrder', 'homeHidden', 'heroTitleAr', 'heroTitleEn', 'heroSubtitleAr',
                               'heroSubtitleEn', 'bannerEnabled', 'bannerAr', 'bannerEn', 'bannerLink', 'theme',
                               'updatedAt', 'updatedBy'])
        && (!('sections' in d) || validSections(d.sections))
        && (!('homeOrder' in d) || (d.homeOrder is list && d.homeOrder.size() <= 7
              && d.homeOrder.hasOnly(['banner', 'alerts', 'nextMass', 'quickContacts', 'milestones', 'directory', 'map'])))
        && (!('homeHidden' in d) || (d.homeHidden is list && d.homeHidden.size() <= 7
              && d.homeHidden.hasOnly(['banner', 'alerts', 'nextMass', 'quickContacts', 'milestones', 'directory', 'map'])))
        && str(d, 'heroTitleAr', 200) && str(d, 'heroTitleEn', 200)
        && str(d, 'heroSubtitleAr', 300) && str(d, 'heroSubtitleEn', 300)
        && d.get('bannerEnabled', false) is bool && str(d, 'bannerAr', 500) && str(d, 'bannerEn', 500)
        && str(d, 'bannerLink', 500)
        // Same as the client: empty, an in-app path, or an http(s) URL with a host.
        && d.get('bannerLink', '').matches('^$|^/([^/ ][^ ]*)?$|^https?://[^/ ]+[.][^/ ]+([/?#][^ ]*)?$')
        && d.get('theme', 'burgundy') in ['burgundy', 'navy', 'green', 'brown', 'purple']
        && stampOk(d);
    }

    // -------------------------------- media ---------------------------------
    // Inline images (base64) referenced by a content doc's image.mediaId.
    // Lists never read these; a card fetches its own image lazily.
    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMedia(request.resource.data);
      allow delete: if isAdmin();
    }

    function validMedia(d) {
      return d.keys().hasOnly(['dataBase64', 'contentType', 'w', 'h', 'bytes', 'createdAt', 'createdBy', 'refs'])
        && d.keys().hasAll(['dataBase64', 'contentType', 'createdAt', 'createdBy'])
        && d.dataBase64 is string && d.dataBase64.size() >= 4 && d.dataBase64.size() <= 950000
        && d.contentType in ['image/jpeg', 'image/webp', 'image/png']
        && optInt(d, 'w', 1, 10000) && optInt(d, 'h', 1, 10000) && optInt(d, 'bytes', 1, 700000)
        && optList(d, 'refs', 20)
        // created now by the signed-in admin, or unchanged on update
        && (d.createdAt == request.time || (resource != null && resource.data.get('createdAt', null) == d.createdAt))
        && (d.createdBy == request.auth.token.get('email', request.auth.uid)
              || (resource != null && resource.data.get('createdBy', null) == d.createdBy));
    }

    // -------------------------------- admins --------------------------------
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Owners manage OTHER admins only: an owner can never demote or remove
      // themselves, so the project always keeps at least one owner.
      allow create, update: if isOwner() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'updatedAt', 'updatedBy'])
        && reqString(request.resource.data, 'email', 254)
        && request.resource.data.role in ['owner', 'editor'];
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // Server-side abuse control: every contact message must be written in the
    // same batch as meta/contact_rate.lastAt = request.time, and that doc may
    // only advance once every 20 seconds (global throttle, no auth needed).
    match /meta/contact_rate {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && (resource == null || request.time > resource.data.lastAt + duration.value(20, 's'));
      allow delete: if false;
    }

    match /contact_messages/{id} {
      allow read, delete: if isAdmin();
      // Admins only toggle the status (new <-> handled).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'handled']
        && stampOk(request.resource.data);
      allow create: if validContactMessage(request.resource.data)
        && getAfter(/databases/$(database)/documents/meta/contact_rate).data.lastAt == request.time;
    }

    function validContactMessage(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'message', 'lang', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'message', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.name.matches('[\\s\\S]*\\S[\\s\\S]*') // not whitespace-only
        && d.message is string && d.message.size() >= 5 && d.message.size() <= 1000
        && d.message.matches('[\\s\\S]*\\S[\\s\\S]*')
        && (!('phone' in d) || (d.phone is string && (d.phone == '' || d.phone.matches('^[0-9+]{5,15}$'))))
        && (!('email' in d) || (d.email is string && d.email.size() <= 254
              && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))))
        // at least one way to reach the sender
        && ((('phone' in d) && d.phone != '') || (('email' in d) && d.email != ''))
        && (!('lang' in d) || d.lang in ['ar', 'en'])
        && d.status == 'new'
        && d.createdAt == request.time;
    }
  }
}
