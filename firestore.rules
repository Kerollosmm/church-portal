rules_version = '2';

// Church portal — Firestore security rules.
// * Public content (incl. settings/church and settings/features): anyone can
//   read; only admins (admins/{uid} exists) write. Every write is validated:
//   a per-collection key allow-list (creates may use only these keys; updates
//   may only change these keys, so legacy fields never block an edit) plus
//   type/size checks on the stored document. Only the keys a write creates
//   or changes are checked (a create checks all of them): Firestore evaluates
//   at most 1,000 expressions per request, which the detail-page fields
//   (gallery, extraFields) would otherwise exceed. Text fields are checked on
//   one joined string (U+001F separator) with regexes for the same reason.
// * media/{mediaId}: optional images stored inline as base64 (Spark plan has
//   no Cloud Storage). Public get by id (never list); admins list and write;
//   size/type validated.
// * contact_messages: public create-only with strict validation, batched
//   with the meta/contact_rate throttle (which can never be written on its
//   own); admins can read them, mark them handled and delete them.
// * admins: a signed-in user reads their own doc; owners read all and add,
//   re-role or remove OTHER admins (never themselves, so an owner always
//   remains). Roles: 'owner' | 'editor' (missing role = editor).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'owner';
    }

    // ---- field helpers (absent or null is accepted for optional fields) ----
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    // Cheaper variant for docs with many text fields (absent = ''; null rejected).
    function str(d, k, max) {
      return d.get(k, '') is string && d.get(k, '').size() <= max;
    }
    // Optional text fields in the joined-string validators are read as
    //   (d.get(k, null) == null ? '' : d.k)
    // so absent or null reads '' and any other value as itself: a non-string
    // (a number, a bool, a list) makes the string `+` fail and the write is
    // denied (string() would turn 123 into '123' and let it pass as text).
    // Written inline: a helper function costs several more of the 1,000
    // expressions per request on every field.
    function reqString(d, k, max) {
      return k in d && d[k] is string && d[k].size() >= 1 && d[k].size() <= max;
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function optInt(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }
    function optNumber(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }
    function optTimestamp(d, k) {
      return !(k in d) || d[k] == null || d[k] is timestamp;
    }
    function optTime(d, k) {
      return !(k in d) || d[k] == null || d[k] == '' || (d[k] is string && d[k].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function optList(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= max);
    }
    function optIn(d, k, values) {
      return !(k in d) || d[k] == null || d[k] in values;
    }
    // Links: absent / null / '' or an http(s) URL with a host (never
    // javascript:, data:, ...). Same pattern as settings/features.bannerLink,
    // but the scheme is case-insensitive like the admin form (Dart's Uri
    // lower-cases it), so e.g. HTTPS://… never blocks an unrelated edit.
    function optHttpUrl(d, k, max) {
      return !(k in d) || d[k] == null
        || (d[k] is string && d[k].size() <= max
            && d[k].matches('^$|^[Hh][Tt][Tt][Pp][Ss]?://[^/ ]+[.][^/ ]+([/?#][^ ]*)?$'));
    }
    // As optHttpUrl, or an in-app path such as /mass-schedule.
    function optUrlOrPath(d, k, max) {
      return !(k in d) || d[k] == null
        || (d[k] is string && d[k].size() <= max
            && d[k].matches('^$|^/([^/ ][^ ]*)?$|^[Hh][Tt][Tt][Pp][Ss]?://[^/ ]+[.][^/ ]+([/?#][^ ]*)?$'));
    }

    // updatedAt / updatedBy (shown in the dashboard) are either untouched or
    // stamped now by the signed-in admin (email, or uid when there is none).
    function stampOk(d) {
      return (!('updatedAt' in d) || d.updatedAt == request.time
              || (resource != null && resource.data.get('updatedAt', null) == d.updatedAt))
        && (!('updatedBy' in d) || d.updatedBy == request.auth.token.get('email', request.auth.uid)
              || (resource != null && resource.data.get('updatedBy', null) == d.updatedBy));
    }

    // Shared by every content document. [changed]: the keys this write
    // creates or changes (changedKeys). Only those are validated: a stored
    // value was validated when it was written, and Firestore evaluates at
    // most 1,000 expressions per request (an edit of a detail page must not
    // pay for every field of the document again).
    function common(d, changed) {
      return d.keys().size() <= 80
        && (!changed.hasAny(['visible', 'sample', 'order'])
            || (optBool(d, 'visible') && optBool(d, 'sample') && optInt(d, 'order', -100000, 100000)))
        && (!('image' in changed) || d.get('image', null) == null || validImage(d.image))
        // Image display style (ADR-023): absent / null = the section default.
        && (!('imageStyle' in changed) || d.get('imageStyle', null) in [null, 'avatar', 'card', 'banner'])
        && (!changed.hasAny(['updatedAt', 'updatedBy']) || stampOk(d));
    }

    // Keys this write creates (all of them) or changes.
    function changedKeys(d) {
      return resource == null ? d.keys().toSet() : d.diff(resource.data).affectedKeys();
    }

    // An update that changes only detail-page / meta keys (each validated on
    // its own) leaves the collection's own fields as they were validated.
    function ownFieldsUnchanged(changed) {
      return resource != null
        && changed.hasOnly(detailKeys().concat(meta()).concat(['image', 'imageStyle', 'contactPhone', 'externalUrl']));
    }

    // Optional `image` map (only collections whose allow-list has 'image').
    // url/storage: an https URL (<= 500 chars); inline: a media/{mediaId}
    // document id; alt <= 300 chars; w / h absent, null or 1..10000. The
    // fields are checked on one joined string (U+001F separator; a non-string
    // makes `+` fail, so the write is denied) to stay within the 1,000
    // expressions Firestore evaluates per request (gallery: up to 8 images).
    // w / h are read with string() ('null' when absent); a string such as
    // '800' is rejected first.
    function validImage(i) {
      let s = i.source + '\u001f' + i.get('url', '') + '\u001f' + i.get('mediaId', '') + '\u001f' + i.get('alt', '')
        + '\u001f' + string(i.get('w', null)) + '\u001f' + string(i.get('h', null));
      return i.keys().hasOnly(['source', 'url', 'mediaId', 'alt', 'w', 'h'])
        && !(i.get('w', null) is string) && !(i.get('h', null) is string)
        && s.matches('(inline\\x1f[^\\x1f]*\\x1f[A-Za-z0-9_-]{1,128}|(url|storage)\\x1fhttps://[^/\\s\\x1f]+[.][^/\\s\\x1f]+([/?#][^\\s\\x1f]*)?\\x1f[^\\x1f]{0,128})\\x1f[^\\x1f]{0,300}\\x1f(null|[1-9][0-9]{0,3}|10000)\\x1f(null|[1-9][0-9]{0,3}|10000)')
        && s.matches('[^\\x1f]*\\x1f[^\\x1f]{0,500}\\x1f[\\s\\S]*');
    }
    function meta() {
      return ['visible', 'sample', 'order', 'updatedAt', 'updatedBy'];
    }

    // ---- optional item detail page (meetings, activities, clinics,
    // facilities, priests, milestones, saints; never liturgies, seasons or
    // alerts). detailKeys() are shared by the 7 collections; each collection
    // also allows the phone / link / image keys it lacks itself (contactPhone,
    // whatsapp, whatsappUrl, facebookUrl, externalUrl, image).
    //
    // Budget: Firestore evaluates at most 1,000 expressions per request.
    // * Detail fields are validated when they are written (a create, or an
    //   update that changes them): stored values were validated when they
    //   were written, so an unrelated edit costs almost nothing.
    // * Text fields are checked together on one joined string (U+001F
    //   separator): a non-string value makes `+` fail, so the write is denied.
    // * List items are checked with one joined string and one regex each, and
    //   the unrolled checks stop at the list's size.
    function detailKeys() {
      return ['detailsEnabled', 'showDetailImages', 'showContacts', 'showSocials', 'detailsAr', 'detailsEn',
              'extraFields', 'gallery', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'youtubeUrl', 'instagramUrl',
              'externalLabelAr', 'externalLabelEn', 'contactNoteAr', 'contactNoteEn'];
    }
    function validDetailCommon(d, changed) {
      return (!('gallery' in changed) || validGallery(d))
        && (!('extraFields' in changed) || validExtraFields(d))
        && (!changed.hasAny(['detailsEnabled', 'showDetailImages', 'showContacts', 'showSocials', 'detailsAr',
                             'detailsEn', 'youtubeUrl', 'instagramUrl', 'externalLabelAr', 'externalLabelEn',
                             'contactNoteAr', 'contactNoteEn']) || validDetailText(d));
    }
    function validDetailText(d) {
      let text = d.get('youtubeUrl', '') + '\u001f' + d.get('instagramUrl', '') + '\u001f'
        + d.get('externalLabelAr', '') + '\u001f' + d.get('externalLabelEn', '') + '\u001f'
        + d.get('contactNoteAr', '') + '\u001f' + d.get('contactNoteEn', '') + '\u001f'
        + d.get('detailsAr', '') + '\u001f' + d.get('detailsEn', '');
      return [d.get('detailsEnabled', false), d.get('showDetailImages', true), d.get('showContacts', true),
              d.get('showSocials', true)].hasOnly([true, false])
        // youtubeUrl, instagramUrl: '' or an http(s) URL (as optHttpUrl);
        // lengths: urls 500, labels 80, notes 500; details 10,000 (below).
        && text.matches('(|[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?)\\x1f(|[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?)(\\x1f[^\\x1f]*){6}')
        && text.matches('[^\\x1f]{0,500}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]{0,80}\\x1f[^\\x1f]{0,80}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]*\\x1f[^\\x1f]*')
        && d.get('detailsAr', '').size() <= 10000 && d.get('detailsEn', '').size() <= 10000;
    }
    // Phone / link keys some collections already had (absent or null
    // accepted, as optString / optHttpUrl): contactPhone and whatsapp <= 20
    // chars; whatsappUrl, facebookUrl, externalUrl '' or an http(s) URL
    // <= 500 chars. Absent / null reads '' (see the field helpers);
    // non-strings are rejected.
    function validDetailContacts(d) {
      let c = (d.get('contactPhone', null) == null ? '' : d.contactPhone) + '\u001f' + (d.get('whatsapp', null) == null ? '' : d.whatsapp) + '\u001f'
        + (d.get('whatsappUrl', null) == null ? '' : d.whatsappUrl) + '\u001f' + (d.get('facebookUrl', null) == null ? '' : d.facebookUrl) + '\u001f'
        + (d.get('externalUrl', null) == null ? '' : d.externalUrl);
      return c.matches('[^\\x1f]{0,20}\\x1f[^\\x1f]{0,20}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]{0,500}')
        && c.matches('[^\\x1f]*\\x1f[^\\x1f]*(\\x1f|\\x1f[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?){3}');
    }
    // Up to 8 images (unrolled: rules have no loops; the checks stop at the
    // list's size).
    function validGallery(d) {
      return optList(d, 'gallery', 8)
        && (d.get('gallery', null) == null || galleryItems(d.gallery, d.gallery.size()));
    }
    function galleryItems(g, n) {
      return (n <= 0 || (galleryImage(g[0]) && (n <= 1 || (galleryImage(g[1]) && (n <= 2 || (galleryImage(g[2]) && (n <= 3 || (galleryImage(g[3]) && true))))))))
        && (n <= 4 || (galleryImage(g[4]) && (n <= 5 || (galleryImage(g[5]) && (n <= 6 || (galleryImage(g[6]) && (n <= 7 || (galleryImage(g[7]) && true))))))));
    }
    // A gallery image: as validImage (keys, source, https URL <= 500 chars or
    // media id, alt <= 300 chars) except w / h, which are not range-checked
    // here (display hints the client reads tolerantly): 8 full image checks
    // would not fit in the 1,000-expression budget of one request.
    function galleryImage(i) {
      let s = i.source + '\u001f' + i.get('url', '') + '\u001f' + i.get('mediaId', '') + '\u001f' + i.get('alt', '');
      return i.keys().hasOnly(['source', 'url', 'mediaId', 'alt', 'w', 'h'])
        && s.matches('(inline\\x1f[^\\x1f]*\\x1f[A-Za-z0-9_-]{1,128}|(url|storage)\\x1fhttps://[^/\\s\\x1f]+[.][^/\\s\\x1f]+([/?#][^\\s\\x1f]*)?\\x1f[^\\x1f]{0,128})\\x1f[^\\x1f]{0,300}')
        && s.matches('[^\\x1f]*\\x1f[^\\x1f]{0,500}\\x1f[\\s\\S]*');
    }
    // Up to 15 admin-defined "title: value" rows.
    function validExtraFields(d) {
      return optList(d, 'extraFields', 15)
        && (d.get('extraFields', null) == null || extraRows(d.extraFields, d.extraFields.size()));
    }
    function extraRows(r, n) {
      return (n <= 0 || (validExtraField(r[0]) && (n <= 1 || (validExtraField(r[1]) && (n <= 2 || (validExtraField(r[2]) && (n <= 3 || (validExtraField(r[3]) && (n <= 4 || (validExtraField(r[4]) && true))))))))))
        && (n <= 5 || (validExtraField(r[5]) && (n <= 6 || (validExtraField(r[6]) && (n <= 7 || (validExtraField(r[7]) && (n <= 8 || (validExtraField(r[8]) && (n <= 9 || (validExtraField(r[9]) && true))))))))))
        && (n <= 10 || (validExtraField(r[10]) && (n <= 11 || (validExtraField(r[11]) && (n <= 12 || (validExtraField(r[12]) && (n <= 13 || (validExtraField(r[13]) && (n <= 14 || (validExtraField(r[14]) && true))))))))));
    }
    // The 4 keys (the admin form always writes all four; each one is read),
    // all strings; titles <= 150 and values <= 2000 chars, and a title: the
    // trimmed titleAr, or else titleEn, must start with a non-space.
    function validExtraField(f) {
      return (f.titleAr + '\u001f' + f.titleEn + '\u001f' + f.valueAr + '\u001f' + f.valueEn)
        .matches('([^\\s\\x1f][^\\x1f]{0,149}\\x1f[^\\x1f]{0,150}|\\x1f[^\\s\\x1f][^\\x1f]{0,149})\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}');
    }

    // Creates may use only [allowed]; updates may only change [allowed].
    function keysAllowed(allowed) {
      return resource == null
        ? request.resource.data.keys().hasOnly(allowed)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ------------------------------- content -------------------------------
    function validContent(col, d) {
      let changed = changedKeys(d);
      // `col in` stops other paths (settings/..., media/...) early: this match
      // also sees them and every request shares one expression budget. The
      // detail-page collections come first (their writes are the heaviest).
      return col in ['meetings', 'activities', 'clinics', 'facilities', 'priests', 'milestones', 'saints', 'alerts',
                     'seasons', 'liturgies', 'categories', 'entries', 'pages']
        && common(d, changed) && (
        (col == 'meetings' && validMeeting(d, changed))
        || (col == 'activities' && validActivity(d, changed))
        || (col == 'clinics' && validClinic(d, changed))
        || (col == 'facilities' && validFacility(d, changed))
        || (col == 'priests' && validPriest(d, changed))
        || (col == 'milestones' && validMilestone(d, changed))
        || (col == 'saints' && validSaint(d, changed))
        || (col == 'alerts' && validAlert(d))
        || (col == 'seasons' && validSeason(d))
        || (col == 'liturgies' && validLiturgy(d))
        || (col == 'categories' && validCategory(d, changed))
        || (col == 'entries' && validEntry(d, changed))
        || (col == 'pages' && validPage(d, changed))
      );
    }

    // ------------- admin-defined categories, items & pages (ADR-027) -------------
    // URL slug: lower-case latin letters / digits joined by single hyphens.
    function slugOk(d) {
      return d.slug is string && d.slug.size() <= 60 && d.slug.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // categories/{id}: name (Arabic required) <= 120, intros <= 1500, a known
    // icon, showInNav bool. Small documents: every write is fully checked.
    function validCategory(d, changed) {
      return changed.hasOnly(['slug', 'nameAr', 'nameEn', 'introAr', 'introEn', 'icon', 'showInNav', 'imageStyle']
                             .concat(meta()))
        && slugOk(d)
        && d.get('icon', 'star') in ['star', 'church', 'people', 'heart', 'book', 'music', 'medical', 'school', 'event',
                                     'volunteer', 'donate', 'info']
        && d.get('showInNav', true) is bool
        && (d.nameAr + '\u001f' + d.get('nameEn', '') + '\u001f' + d.get('introAr', '') + '\u001f' + d.get('introEn', ''))
             .matches('[^\\x1f]*[^\\s\\x1f][^\\x1f]*\\x1f[\\s\\S]*')
        && (d.nameAr + '\u001f' + d.get('nameEn', '') + '\u001f' + d.get('introAr', '') + '\u001f' + d.get('introEn', ''))
             .matches('[^\\x1f]{1,120}\\x1f[^\\x1f]{0,120}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,500}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,500}');
    }

    // entries/{id}: an item of a custom category. categoryId names a category
    // document (its existence is not required: an item whose category was
    // deleted is never shown publicly and can be reassigned).
    function validEntry(d, changed) {
      let o = d.titleAr + '\u001f' + d.get('titleEn', '') + '\u001f' + d.get('descAr', '') + '\u001f' + d.get('descEn', '')
        + '\u001f' + d.get('contactPhone', '') + '\u001f' + d.get('externalUrl', '') + '\u001f' + d.get('externalLabelAr', '')
        + '\u001f' + d.get('externalLabelEn', '');
      return changed.hasOnly(['categoryId', 'titleAr', 'titleEn', 'descAr', 'descEn', 'contactPhone', 'externalUrl',
                              'externalLabelAr', 'externalLabelEn', 'image', 'imageStyle'].concat(meta()).concat(['sample']))
        && d.categoryId is string && d.categoryId.matches('[A-Za-z0-9_-]{1,128}')
        && o.matches('[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[0-9+]{0,20}\\x1f(|/([^/ \\x1f][^ \\x1f]*)?|[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?)\\x1f[^\\x1f]{0,80}\\x1f[^\\x1f]{0,80}')
        && d.get('externalUrl', '').size() <= 500;
    }

    // pages/{id}: a custom page. The header fields are checked when a write
    // creates the page or changes one of them; the blocks when they change
    // (their own write, like gallery / extraFields: expression budget).
    function validPage(d, changed) {
      return changed.hasOnly(['slug', 'titleAr', 'titleEn', 'subtitleAr', 'subtitleEn', 'image', 'blocks', 'showInNav']
                             .concat(meta()))
        && ((resource != null && !changed.hasAny(['slug', 'titleAr', 'titleEn', 'subtitleAr', 'subtitleEn', 'showInNav']))
            || (slugOk(d) && d.get('showInNav', false) is bool
                && (d.titleAr + '\u001f' + d.get('titleEn', '') + '\u001f' + d.get('subtitleAr', '') + '\u001f' + d.get('subtitleEn', ''))
                     .matches('[^\\x1f]*[^\\s\\x1f][^\\x1f]*\\x1f[\\s\\S]*')
                && (d.titleAr + '\u001f' + d.get('titleEn', '') + '\u001f' + d.get('subtitleAr', '') + '\u001f' + d.get('subtitleEn', ''))
                     .matches('[^\\x1f]{1,200}\\x1f[^\\x1f]{0,200}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}')))
        && (!('blocks' in changed) || validBlocks(d));
    }

    // Up to 20 blocks (unrolled: rules have no loops).
    function validBlocks(d) {
      return optList(d, 'blocks', 20)
        && (d.get('blocks', null) == null || blockItems(d.blocks, d.blocks.size()));
    }
    function blockItems(b, n) {
      return (n <= 0 || (validPageBlock(b[0]) && (n <= 1 || (validPageBlock(b[1]) && (n <= 2 || (validPageBlock(b[2]) && (n <= 3 || (validPageBlock(b[3]) && (n <= 4 || (validPageBlock(b[4]) && true))))))))))
        && (n <= 5 || (validPageBlock(b[5]) && (n <= 6 || (validPageBlock(b[6]) && (n <= 7 || (validPageBlock(b[7]) && (n <= 8 || (validPageBlock(b[8]) && (n <= 9 || (validPageBlock(b[9]) && true))))))))))
        && (n <= 10 || (validPageBlock(b[10]) && (n <= 11 || (validPageBlock(b[11]) && (n <= 12 || (validPageBlock(b[12]) && (n <= 13 || (validPageBlock(b[13]) && (n <= 14 || (validPageBlock(b[14]) && true))))))))))
        && (n <= 15 || (validPageBlock(b[15]) && (n <= 16 || (validPageBlock(b[16]) && (n <= 17 || (validPageBlock(b[17]) && (n <= 18 || (validPageBlock(b[18]) && (n <= 19 || (validPageBlock(b[19]) && true))))))))));
    }
    // A block is ONE string: type, textAr, textEn, url, account, instapay,
    // wallet joined by U+001F (lib/domain/custom_content.dart PageBlock.encode;
    // one regex per block keeps 20 blocks within the 1,000-expression budget).
    // type: heading / paragraph / image / button / link / donation; texts
    // <= 4000; url '' / an in-app path / an http(s) URL (an image needs an
    // https link); donation account <= 120, InstaPay <= 80, wallet <= 30;
    // the whole block <= 9000. Display only: nothing is processed.
    function validPageBlock(b) {
      return b is string && b.size() <= 9000
        && b.matches('(image\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1fhttps://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?|(heading|paragraph|button|link|donation)\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f(|/([^/ \\x1f][^ \\x1f]*)?|[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?))\\x1f[^\\x1f]{0,120}\\x1f[^\\x1f]{0,80}\\x1f[^\\x1f]{0,30}');
    }

    function validAlert(d) {
      return keysAllowed(['titleAr', 'titleEn', 'bodyAr', 'bodyEn', 'active', 'startsAt', 'endsAt', 'priority', 'link',
                          'image', 'imageStyle'].concat(meta()))
        && reqString(d, 'titleAr', 300) && optString(d, 'titleEn', 300)
        && optString(d, 'bodyAr', 2000) && optString(d, 'bodyEn', 2000)
        && optBool(d, 'active') && optTimestamp(d, 'startsAt') && optTimestamp(d, 'endsAt')
        && optInt(d, 'priority', 0, 1000) && optUrlOrPath(d, 'link', 500);
    }

    function validSeason(d) {
      return keysAllowed(['key', 'nameAr', 'nameEn', 'startsAt', 'endsAt', 'active', 'replacesRegular',
                          'image', 'imageStyle'].concat(meta()))
        && d.key in ['holy_week', 'pascha', 'nativity', 'revival_maximus', 'revival_moses', 'summer']
        && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optTimestamp(d, 'startsAt') && optTimestamp(d, 'endsAt') && optBool(d, 'active')
        && optBool(d, 'replacesRegular');
    }

    function validLiturgy(d) {
      return keysAllowed(['type', 'nameAr', 'nameEn', 'weekday', 'date', 'start', 'end', 'placeAr', 'placeEn',
                          'audienceAr', 'audienceEn', 'seasonKey'].concat(meta()))
        && optIn(d, 'type', ['mass', 'vespers', 'praise', 'other'])
        && reqString(d, 'nameAr', 300) && optString(d, 'nameEn', 300)
        && optInt(d, 'weekday', 1, 7) && optTimestamp(d, 'date')
        && 'start' in d && d.start is string && optTime(d, 'start') && optTime(d, 'end')
        && optString(d, 'placeAr', 300) && optString(d, 'placeEn', 300)
        && optString(d, 'audienceAr', 300) && optString(d, 'audienceEn', 300)
        && optIn(d, 'seasonKey', ['holy_week', 'pascha', 'nativity', 'revival_maximus', 'revival_moses', 'summer']);
    }

    function validMeeting(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['stage', 'nameAr', 'nameEn', 'weekday', 'start', 'end', 'hallAr', 'hallEn',
                          'facebookUrl', 'whatsappUrl', 'notes', 'image', 'imageStyle', 'contactPhone',
                          'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownMeeting(d));
    }

    function validActivity(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['category', 'titleAr', 'titleEn', 'descAr', 'descEn', 'scheduleAr', 'scheduleEn',
                          'ageRange', 'contactPhone', 'link', 'image', 'imageStyle'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownActivity(d));
    }

    function validClinic(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['specialty', 'specialtyAr', 'specialtyEn', 'doctorName', 'degreeAr', 'degreeEn', 'days',
                          'start', 'end', 'bookingPhone', 'whatsapp', 'active', 'image', 'imageStyle',
                          'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownClinic(d));
    }

    function validFacility(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['type', 'nameAr', 'nameEn', 'descAr', 'descEn', 'phone', 'hoursAr', 'hoursEn', 'image', 'imageStyle',
                          'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownFacility(d));
    }

    function validPriest(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['name', 'nameEn', 'photoUrl', 'rank', 'ordinationDate', 'hegumenDate', 'departedDate',
                          'status', 'bioAr', 'bioEn', 'image', 'imageStyle', 'contactPhone',
                          'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownPriest(d));
    }

    function validMilestone(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['titleAr', 'titleEn', 'descAr', 'descEn', 'year', 'icon', 'image', 'imageStyle', 'contactPhone',
                          'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownMilestone(d));
    }

    function validSaint(d, changed) {
      // = keysAllowed(...), reusing the changed keys.
      return changed.hasOnly(['nameAr', 'nameEn', 'bioAr', 'bioEn', 'feastCopticAr', 'feastCopticEn', 'feastGregorian',
                          'feastGregorianAr', 'image', 'imageStyle', 'contactPhone', 'externalUrl'].concat(meta()).concat(detailKeys()))
        && validDetailCommon(d, changed)
        && (!changed.hasAny(['contactPhone', 'whatsapp', 'whatsappUrl', 'facebookUrl', 'externalUrl']) || validDetailContacts(d))
        && (ownFieldsUnchanged(changed) || ownSaint(d));
    }

    // Each collection's own fields, checked on one joined string (see
    // validImage). Optional text fields are read as described with the field
    // helpers (absent / null reads '', non-strings are rejected); required
    // fields must be non-empty strings. Phone / link keys shared with
    // validDetailContacts (meetings' facebookUrl / whatsappUrl, activities'
    // contactPhone, clinics' whatsapp) are checked there whenever a write
    // creates or changes them. Numbers (weekday, year) are read with string()
    // ('null' when absent) after a string such as '5' is rejected.
    function ownMeeting(d) {
      let o = d.stage + '\u001f' + d.nameAr + '\u001f' + (d.get('nameEn', null) == null ? '' : d.nameEn)
        + '\u001f' + string(d.get('weekday', null)) + '\u001f' + (d.get('start', null) == null ? '' : d.start)
        + '\u001f' + (d.get('end', null) == null ? '' : d.end) + '\u001f' + (d.get('hallAr', null) == null ? '' : d.hallAr)
        + '\u001f' + (d.get('hallEn', null) == null ? '' : d.hallEn) + '\u001f' + (d.get('notes', null) == null ? '' : d.notes);
      return !(d.get('weekday', null) is string)
        && o.matches('[^\\x1f]{1,40}\\x1f[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f(null|[1-7])\\x1f(|([01][0-9]|2[0-3]):[0-5][0-9])\\x1f(|([01][0-9]|2[0-3]):[0-5][0-9])\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}');
    }
    function ownActivity(d) {
      let o = (d.get('category', null) == null ? '' : d.category) + '\u001f' + d.titleAr
        + '\u001f' + (d.get('titleEn', null) == null ? '' : d.titleEn) + '\u001f' + (d.get('descAr', null) == null ? '' : d.descAr)
        + '\u001f' + (d.get('descEn', null) == null ? '' : d.descEn) + '\u001f' + (d.get('scheduleAr', null) == null ? '' : d.scheduleAr)
        + '\u001f' + (d.get('scheduleEn', null) == null ? '' : d.scheduleEn) + '\u001f' + (d.get('ageRange', null) == null ? '' : d.ageRange)
        + '\u001f' + (d.get('link', null) == null ? '' : d.link);
      return o.matches('[^\\x1f]{0,40}\\x1f[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,60}\\x1f(|[Hh][Tt][Tt][Pp][Ss]?://[^/ \\x1f]+[.][^/ \\x1f]+([/?#][^ \\x1f]*)?)')
        && o.matches('[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]{0,500}');
    }
    function ownClinic(d) {
      let o = d.specialty + '\u001f' + d.specialtyAr + '\u001f' + (d.get('specialtyEn', null) == null ? '' : d.specialtyEn)
        + '\u001f' + d.doctorName + '\u001f' + (d.get('degreeAr', null) == null ? '' : d.degreeAr)
        + '\u001f' + (d.get('degreeEn', null) == null ? '' : d.degreeEn) + '\u001f' + (d.get('start', null) == null ? '' : d.start)
        + '\u001f' + (d.get('end', null) == null ? '' : d.end) + '\u001f' + (d.get('bookingPhone', null) == null ? '' : d.bookingPhone);
      return o.matches('[^\\x1f]{1,40}\\x1f[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f(|([01][0-9]|2[0-3]):[0-5][0-9])\\x1f(|([01][0-9]|2[0-3]):[0-5][0-9])\\x1f[^\\x1f]{0,20}')
        && optList(d, 'days', 7) && d.get('days', []).hasOnly([1, 2, 3, 4, 5, 6, 7]) && optBool(d, 'active');
    }
    function ownFacility(d) {
      let o = (d.get('type', null) == null ? '' : d.type) + '\u001f' + d.nameAr + '\u001f' + (d.get('nameEn', null) == null ? '' : d.nameEn)
        + '\u001f' + (d.get('descAr', null) == null ? '' : d.descAr) + '\u001f' + (d.get('descEn', null) == null ? '' : d.descEn)
        + '\u001f' + (d.get('phone', null) == null ? '' : d.phone) + '\u001f' + (d.get('hoursAr', null) == null ? '' : d.hoursAr)
        + '\u001f' + (d.get('hoursEn', null) == null ? '' : d.hoursEn);
      return o.matches('[^\\x1f]{0,40}\\x1f[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,20}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}');
    }
    function ownPriest(d) {
      let o = d.name + '\u001f' + (d.get('nameEn', null) == null ? '' : d.nameEn) + '\u001f' + (d.get('photoUrl', null) == null ? '' : d.photoUrl)
        + '\u001f' + (d.get('ordinationDate', null) == null ? '' : d.ordinationDate) + '\u001f' + (d.get('hegumenDate', null) == null ? '' : d.hegumenDate)
        + '\u001f' + (d.get('departedDate', null) == null ? '' : d.departedDate) + '\u001f' + (d.get('bioAr', null) == null ? '' : d.bioAr)
        + '\u001f' + (d.get('bioEn', null) == null ? '' : d.bioEn);
      return d.get('rank', null) in [null, 'hegumen', 'priest'] && d.get('status', null) in [null, 'serving', 'departed']
        && o.matches('[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,500}\\x1f[^\\x1f]{0,10}\\x1f[^\\x1f]{0,10}\\x1f[^\\x1f]{0,10}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}');
    }
    function ownMilestone(d) {
      let o = d.titleAr + '\u001f' + (d.get('titleEn', null) == null ? '' : d.titleEn)
        + '\u001f' + (d.get('descAr', null) == null ? '' : d.descAr) + '\u001f' + (d.get('descEn', null) == null ? '' : d.descEn)
        + '\u001f' + string(d.get('year', null)) + '\u001f' + (d.get('icon', null) == null ? '' : d.icon);
      return !(d.get('year', null) is string)
        && o.matches('[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f(null|[1-9][0-9]{0,2}|1[0-9]{3}|2[01][0-9]{2}|2200)\\x1f[^\\x1f]{0,40}');
    }
    function ownSaint(d) {
      let o = d.nameAr + '\u001f' + (d.get('nameEn', null) == null ? '' : d.nameEn) + '\u001f' + (d.get('bioAr', null) == null ? '' : d.bioAr)
        + '\u001f' + (d.get('bioEn', null) == null ? '' : d.bioEn) + '\u001f' + (d.get('feastCopticAr', null) == null ? '' : d.feastCopticAr)
        + '\u001f' + (d.get('feastCopticEn', null) == null ? '' : d.feastCopticEn) + '\u001f' + (d.get('feastGregorian', null) == null ? '' : d.feastGregorian)
        + '\u001f' + (d.get('feastGregorianAr', null) == null ? '' : d.feastGregorianAr);
      return o.matches('[^\\x1f]{1,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}');
    }

    match /{col}/{docId} {
      allow read: if col in ['alerts', 'seasons', 'liturgies', 'meetings', 'activities',
                             'clinics', 'facilities', 'priests', 'milestones', 'saints',
                             'categories', 'entries', 'pages'];
      allow create, update: if isAdmin() && validContent(col, request.resource.data);
      allow delete: if isAdmin() && col in ['alerts', 'seasons', 'liturgies', 'meetings', 'activities',
                                            'clinics', 'facilities', 'priests', 'milestones', 'saints',
                                            'categories', 'entries', 'pages'];
    }

    // ------------------------------- settings -------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((docId == 'church' && validChurch(request.resource.data))
            || (docId == 'features' && validFeatures(request.resource.data))
            || (docId == 'contact' && validContactSettings(request.resource.data)));
      allow delete: if false;
    }

    function validChurch(d) {
      return keysAllowed(['nameAr', 'nameEn', 'addressAr', 'addressEn', 'transportAr', 'transportEn', 'lat', 'lng',
                          'coordinatesApproximate', 'mapsUrl', 'mapsQuery', 'phones', 'whatsapp', 'whatsappChannel',
                          'facebook', 'youtube', 'instagram', 'verseAr', 'verseEn', 'verseRef', 'verseRefAr',
                          'heroImageUrl', 'historyAr', 'historyEn', 'bishopAr', 'bishopEn', 'altars',
                          'assistantEnabled', 'sample', 'updatedAt', 'updatedBy'])
        && reqString(d, 'nameAr', 300) && str(d, 'nameEn', 300)
        && str(d, 'addressAr', 300) && str(d, 'addressEn', 300)
        && str(d, 'transportAr', 2000) && str(d, 'transportEn', 2000)
        && optNumber(d, 'lat', -90, 90) && optNumber(d, 'lng', -180, 180)
        && optBool(d, 'coordinatesApproximate')
        && str(d, 'mapsUrl', 500) && str(d, 'mapsQuery', 200)
        && d.get('phones', []) is list && d.get('phones', []).size() <= 20
        && d.get('altars', []) is list && d.get('altars', []).size() <= 20
        && str(d, 'whatsapp', 20)
        && str(d, 'whatsappChannel', 500) && optHttpUrl(d, 'whatsappChannel', 500)
        && str(d, 'facebook', 500) && optHttpUrl(d, 'facebook', 500)
        && str(d, 'youtube', 500) && optHttpUrl(d, 'youtube', 500)
        && str(d, 'instagram', 500) && optHttpUrl(d, 'instagram', 500)
        && str(d, 'verseAr', 300) && str(d, 'verseEn', 300)
        && str(d, 'verseRef', 60) && str(d, 'verseRefAr', 60) && str(d, 'heroImageUrl', 500)
        && str(d, 'historyAr', 8000) && str(d, 'historyEn', 8000)
        && str(d, 'bishopAr', 300) && str(d, 'bishopEn', 300)
        && d.get('assistantEnabled', false) is bool && d.get('sample', false) is bool
        && stampOk(d);
    }

    function sectionKeys() {
      return ['schedule', 'meetings', 'clinics', 'services', 'history', 'milestones', 'saints', 'priests',
              'departedPriests', 'activities', 'alerts', 'contactInfo', 'socials', 'contactForm', 'assistant', 'media',
              'dailyVerse'];
    }

    // Known section keys only, and every value a bool.
    function validSections(s) {
      return s is map && s.keys().hasOnly(sectionKeys()) && s.values().hasOnly([true, false]);
    }

    function validFeatures(d) {
      // Like settings/church: an untouched legacy key does not block an edit.
      // Only the keys this write creates or changes are validated (the admin
      // saves the whole document; Firestore evaluates at most 1,000
      // expressions per request).
      let changed = changedKeys(d);
      return keysAllowed(['sections', 'homeOrder', 'homeHidden', 'heroTitleAr', 'heroTitleEn', 'heroSubtitleAr',
                          'heroSubtitleEn', 'bannerEnabled', 'bannerAr', 'bannerEn', 'bannerLink', 'theme',
                          'pageHeaders', 'footer', 'heroMotion', 'imageStyles', 'dailyVerse', 'occasions', 'themeColors',
                          'heroVideos', 'updatedAt', 'updatedBy'])
        && (!('sections' in changed) || !('sections' in d) || validSections(d.sections))
        && (!('homeOrder' in changed) || !('homeOrder' in d) || (d.homeOrder is list && d.homeOrder.size() <= 7
              && d.homeOrder.hasOnly(['banner', 'alerts', 'nextMass', 'quickContacts', 'milestones', 'directory', 'map'])))
        && (!('homeHidden' in changed) || !('homeHidden' in d) || (d.homeHidden is list && d.homeHidden.size() <= 7
              && d.homeHidden.hasOnly(['banner', 'alerts', 'nextMass', 'quickContacts', 'milestones', 'directory', 'map'])))
        && (!changed.hasAny(['heroTitleAr', 'heroTitleEn', 'heroSubtitleAr', 'heroSubtitleEn', 'bannerEnabled', 'bannerAr',
                             'bannerEn'])
            || (str(d, 'heroTitleAr', 200) && str(d, 'heroTitleEn', 200)
                && str(d, 'heroSubtitleAr', 300) && str(d, 'heroSubtitleEn', 300)
                && d.get('bannerEnabled', false) is bool && str(d, 'bannerAr', 500) && str(d, 'bannerEn', 500)))
        // Same as the client and alert links: empty, an in-app path, or an
        // http(s) URL with a host (scheme case-insensitive).
        && (!('bannerLink' in changed) || optUrlOrPath(d, 'bannerLink', 500))
        // Theme presets (ADR-025); `burgundy` = the pre-ADR-025 default, read as goldenHour.
        && (!('theme' in changed) || d.get('theme', 'goldenHour') in themeKeys().concat(['burgundy']))
        && (!('occasions' in changed) || !('occasions' in d) || validOccasions(d.occasions))
        && (!('themeColors' in changed) || !('themeColors' in d) || validThemeColors(d.themeColors))
        && (!('heroVideos' in changed) || !('heroVideos' in d) || validHeroVideos(d.heroVideos))
        && (!('footer' in changed) || !('footer' in d) || validFooter(d.footer))
        // Hero motion & video switch (ADR-022): a bool, default on.
        && (!('heroMotion' in changed) || d.get('heroMotion', true) is bool)
        // Per-section default image display style (ADR-023).
        && (!('imageStyles' in changed) || !('imageStyles' in d) || (d.imageStyles is map
              && d.imageStyles.keys().hasOnly(['priests', 'saints', 'activities', 'milestones', 'meetings', 'alerts',
                                               'seasons', 'facilities', 'clinics'])
              && d.imageStyles.values().hasOnly(['avatar', 'card', 'banner'])))
        && (!('pageHeaders' in changed) || !('pageHeaders' in d) || validPageHeaders(d.pageHeaders))
        // Verse of the day mode / fixed verse (missing = daily rotation).
        && (!('dailyVerse' in changed) || !('dailyVerse' in d) || validDailyVerse(d.dailyVerse))
        && (!changed.hasAny(['updatedAt', 'updatedBy']) || stampOk(d));
    }

    // ------------------- occasion themes & hero videos -----------------------
    function themeKeys() {
      return ['goldenHour', 'holyWeek', 'resurrection', 'nativity', 'epiphany', 'fasting', 'marian', 'navy', 'green',
              'brown', 'purple'];
    }

    // Occasion themes (ADR-025): automatic switching, Easter and schedule
    // slots r1…r12 ('theme|start|end', Cairo dates, start <= end). Colour
    // edits are a separate field, themeColors (one string per preset), so
    // each has its own write and expression budget. Only changed slots /
    // presets are validated. Contrast is enforced by the app, which also
    // re-corrects any stored palette when it renders.
    function validOccasions(o) {
      let old = resource == null ? {} : resource.data.get('occasions', {});
      return o is map && o.keys().hasOnly(['auto', 'easter', 'resurrectionDays', 'schedule'])
        && [o.get('auto', false), o.get('easter', true)].hasOnly([true, false])
        && o.get('resurrectionDays', 7) is int
        && o.get('resurrectionDays', 7) >= 1 && o.get('resurrectionDays', 7) <= 50
        && o.get('schedule', {}) is map
        && o.get('schedule', {}).keys().hasOnly(['r1', 'r2', 'r3', 'r4', 'r5', 'r6', 'r7', 'r8', 'r9', 'r10', 'r11', 'r12'])
        && validRanges(o.get('schedule', {}),
             o.get('schedule', {}).diff(old is map && old.get('schedule', {}) is map ? old.get('schedule', {}) : {})
               .affectedKeys());
    }

    // [ch]: the slots this write adds or changes (computed once by the caller).
    function validRanges(s, ch) {
      return (!ch.hasAny(['r1']) || !('r1' in s) || validRange(s.r1))
        && (!ch.hasAny(['r2']) || !('r2' in s) || validRange(s.r2))
        && (!ch.hasAny(['r3']) || !('r3' in s) || validRange(s.r3))
        && (!ch.hasAny(['r4']) || !('r4' in s) || validRange(s.r4))
        && (!ch.hasAny(['r5']) || !('r5' in s) || validRange(s.r5))
        && (!ch.hasAny(['r6']) || !('r6' in s) || validRange(s.r6))
        && (!ch.hasAny(['r7']) || !('r7' in s) || validRange(s.r7))
        && (!ch.hasAny(['r8']) || !('r8' in s) || validRange(s.r8))
        && (!ch.hasAny(['r9']) || !('r9' in s) || validRange(s.r9))
        && (!ch.hasAny(['r10']) || !('r10' in s) || validRange(s.r10))
        && (!ch.hasAny(['r11']) || !('r11' in s) || validRange(s.r11))
        && (!ch.hasAny(['r12']) || !('r12' in s) || validRange(s.r12));
    }

    // 'theme|YYYY-MM-DD|YYYY-MM-DD': a known preset, two dates (2000–2099),
    // start <= end. One string per slot keeps twelve slots within budget.
    function validRange(r) {
      return r is string && r.matches(
             '(goldenHour|holyWeek|resurrection|nativity|epiphany|fasting|marian|navy|green|brown|purple)'
             + '[|]20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|]20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && r.split('[|]')[1] <= r.split('[|]')[2];
    }

    // Admin colour edits per preset (settings/features.themeColors).
    function validThemeColors(c) {
      let old = resource == null ? {} : resource.data.get('themeColors', {});
      return c is map && c.keys().hasOnly(themeKeys())
        && validCustom(c, c.diff(old is map ? old : {}).affectedKeys());
    }

    function validCustom(c, ch) {
      return (!ch.hasAny(['goldenHour']) || !('goldenHour' in c) || validPalette(c.goldenHour))
        && (!ch.hasAny(['holyWeek']) || !('holyWeek' in c) || validPalette(c.holyWeek))
        && (!ch.hasAny(['resurrection']) || !('resurrection' in c) || validPalette(c.resurrection))
        && (!ch.hasAny(['nativity']) || !('nativity' in c) || validPalette(c.nativity))
        && (!ch.hasAny(['epiphany']) || !('epiphany' in c) || validPalette(c.epiphany))
        && (!ch.hasAny(['fasting']) || !('fasting' in c) || validPalette(c.fasting))
        && (!ch.hasAny(['marian']) || !('marian' in c) || validPalette(c.marian))
        && (!ch.hasAny(['navy']) || !('navy' in c) || validPalette(c.navy))
        && (!ch.hasAny(['green']) || !('green' in c) || validPalette(c.green))
        && (!ch.hasAny(['brown']) || !('brown' in c) || validPalette(c.brown))
        && (!ch.hasAny(['purple']) || !('purple' in c) || validPalette(c.purple));
    }

    // The ten palette colours in a fixed order (primary, onPrimary,
    // onPrimaryAccent, background, surface, surfaceAlt, ink, muted, goldText,
    // script), '|'-separated; each an opaque #RRGGBB or empty (= the preset's).
    function validPalette(p) {
      return p is string && p.matches('((#[0-9A-Fa-f]{6})?[|]){9}(#[0-9A-Fa-f]{6})?');
    }

    function videoSlots() {
      return ['v1', 'v2', 'v3', 'v4', 'v5', 'v6', 'v7', 'v8', 'v9', 'v10', 'v11', 'v12'];
    }

    // Hero video library (ADR-026): slots v1…v12 {name <= 80, url = a
    // youtube.com/watch?v= or youtu.be/ link with an 11-character id}, the
    // active slot ('' = the bundled clip) and an optional slot per preset.
    function validHeroVideos(v) {
      let old = resource == null ? {} : resource.data.get('heroVideos', {});
      let oldItems = old is map && old.get('items', {}) is map ? old.get('items', {}) : {};
      return v is map && v.keys().hasOnly(['items', 'active', 'byTheme'])
        && v.get('items', {}) is map && v.get('items', {}).keys().hasOnly(videoSlots())
        && v.get('active', '') in [''].concat(videoSlots())
        && v.get('byTheme', {}) is map && v.get('byTheme', {}).keys().hasOnly(themeKeys())
        && v.get('byTheme', {}).values().hasOnly(videoSlots())
        && validVideoSlots(v.get('items', {}), v.get('items', {}).diff(oldItems).affectedKeys());
    }

    function validVideoSlots(s, ch) {
      return (!ch.hasAny(['v1']) || !('v1' in s) || validVideo(s.v1))
        && (!ch.hasAny(['v2']) || !('v2' in s) || validVideo(s.v2))
        && (!ch.hasAny(['v3']) || !('v3' in s) || validVideo(s.v3))
        && (!ch.hasAny(['v4']) || !('v4' in s) || validVideo(s.v4))
        && (!ch.hasAny(['v5']) || !('v5' in s) || validVideo(s.v5))
        && (!ch.hasAny(['v6']) || !('v6' in s) || validVideo(s.v6))
        && (!ch.hasAny(['v7']) || !('v7' in s) || validVideo(s.v7))
        && (!ch.hasAny(['v8']) || !('v8' in s) || validVideo(s.v8))
        && (!ch.hasAny(['v9']) || !('v9' in s) || validVideo(s.v9))
        && (!ch.hasAny(['v10']) || !('v10' in s) || validVideo(s.v10))
        && (!ch.hasAny(['v11']) || !('v11' in s) || validVideo(s.v11))
        && (!ch.hasAny(['v12']) || !('v12' in s) || validVideo(s.v12));
    }

    function validVideo(e) {
      return e is map && e.size() == 2
        && (e.name + '\u001f' + e.url).matches(
             '[^\\x1f]{1,80}\\x1fhttps://(www[.]youtube[.]com/watch[?]v=|youtu[.]be/)[A-Za-z0-9_-]{11}');
    }

    // Verse of the day: daily rotation or a fixed admin-entered verse (Arabic
    // text <= 500 chars, reference <= 60). On/off is sections.dailyVerse.
    function validDailyVerse(v) {
      return v is map && v.keys().hasOnly(['mode', 'textAr', 'refAr'])
        && v.get('mode', 'daily') in ['daily', 'fixed']
        && v.get('textAr', '') is string && v.get('refAr', '') is string
        && (v.get('textAr', '') + '\u001f' + v.get('refAr', '')).matches('[^\\x1f]{0,500}\\x1f[^\\x1f]{0,60}');
    }

    // Footer options (FR-G-04).
    function validFooter(f) {
      return f is map && f.keys().hasOnly(['showPhones', 'showSocials', 'showQuickLinks', 'noteAr', 'noteEn'])
        && [f.get('showPhones', true), f.get('showSocials', true), f.get('showQuickLinks', true)].hasOnly([true, false])
        && (f.get('noteAr', '') + '\u001f' + f.get('noteEn', '')).matches('[^\\x1f]{0,500}\\x1f[^\\x1f]{0,500}');
    }

    // Per-page header / intro overrides; known pages only. Only the pages
    // this write adds or changes are validated (expression budget).
    function validPageHeaders(h) {
      let old = resource == null ? {} : resource.data.get('pageHeaders', {});
      let changed = old is map ? h.diff(old).affectedKeys() : h.keys().toSet();
      return h is map
        && h.keys().hasOnly(['about', 'schedule', 'education', 'activities', 'clinics', 'services', 'contact', 'ask'])
        && (!changed.hasAny(['about']) || !('about' in h) || validPageHeader(h.about))
        && (!changed.hasAny(['schedule']) || !('schedule' in h) || validPageHeader(h.schedule))
        && (!changed.hasAny(['education']) || !('education' in h) || validPageHeader(h.education))
        && (!changed.hasAny(['activities']) || !('activities' in h) || validPageHeader(h.activities))
        && (!changed.hasAny(['clinics']) || !('clinics' in h) || validPageHeader(h.clinics))
        && (!changed.hasAny(['services']) || !('services' in h) || validPageHeader(h.services))
        && (!changed.hasAny(['contact']) || !('contact' in h) || validPageHeader(h.contact))
        && (!changed.hasAny(['ask']) || !('ask' in h) || validPageHeader(h.ask));
    }
    // Exactly the 6 keys (the admin form always writes all six: size 6 and
    // each one read), all strings; titles <= 200, subtitles <= 300, intros
    // <= 1500 chars.
    function validPageHeader(p) {
      return p.size() == 6
        && (p.titleAr + '\u001f' + p.titleEn + '\u001f' + p.subtitleAr + '\u001f' + p.subtitleEn + '\u001f' + p.introAr + '\u001f' + p.introEn)
          .matches('[^\\x1f]{0,200}\\x1f[^\\x1f]{0,200}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,300}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,500}\\x1f[^\\x1f]{0,1000}[^\\x1f]{0,500}');
    }

    // -------------------------------- media ---------------------------------
    // Inline images (base64) referenced by a content doc's image.mediaId.
    // Lists never read these; a card fetches its own image lazily by id, so
    // the public may get one document but never list (scrape) the collection.
    match /media/{mediaId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validMedia(request.resource.data);
      allow delete: if isAdmin();
    }

    function validMedia(d) {
      return d.keys().hasOnly(['dataBase64', 'contentType', 'w', 'h', 'bytes', 'createdAt', 'createdBy', 'refs'])
        && d.keys().hasAll(['dataBase64', 'contentType', 'createdAt', 'createdBy'])
        && d.dataBase64 is string && d.dataBase64.size() >= 4 && d.dataBase64.size() <= 950000
        && d.contentType in ['image/jpeg', 'image/webp', 'image/png']
        && optInt(d, 'w', 1, 10000) && optInt(d, 'h', 1, 10000) && optInt(d, 'bytes', 1, 700000)
        && optList(d, 'refs', 20)
        // created now by the signed-in admin, or unchanged on update
        && (d.createdAt == request.time || (resource != null && resource.data.get('createdAt', null) == d.createdAt))
        && (d.createdBy == request.auth.token.get('email', request.auth.uid)
              || (resource != null && resource.data.get('createdBy', null) == d.createdBy));
    }

    // -------------------------------- admins --------------------------------
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Owners manage OTHER admins only: an owner can never demote or remove
      // themselves, so the project always keeps at least one owner.
      allow create, update: if isOwner() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'updatedAt', 'updatedBy'])
        && reqString(request.resource.data, 'email', 254)
        && request.resource.data.role in ['owner', 'editor']
        && stampOk(request.resource.data);
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // Server-side abuse control: every contact message must be written in the
    // same batch as meta/contact_rate {lastAt: request.time, lastMsgId: <that
    // message's id>}, and that doc may only advance once every 10 seconds
    // (global throttle, no auth needed). lastMsgId must name a message that
    // did not exist before this write and does exist after it, so the
    // throttle can never be bumped on its own (no standalone DoS pings).
    match /meta/contact_rate {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['lastAt', 'lastMsgId'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastMsgId is string
        && request.resource.data.lastMsgId.size() >= 10 && request.resource.data.lastMsgId.size() <= 64
        && request.resource.data.lastMsgId.matches('^[A-Za-z0-9]+$')
        && !exists(/databases/$(database)/documents/contact_messages/$(request.resource.data.lastMsgId))
        && existsAfter(/databases/$(database)/documents/contact_messages/$(request.resource.data.lastMsgId))
        && (resource == null || request.time > resource.data.lastAt + duration.value(10, 's'));
      allow delete: if false;
    }

    match /contact_messages/{id} {
      allow read, delete: if isAdmin();
      // Admins change the status (new / handled; bookings: new / contacted /
      // confirmed / declined) and internal notes (<= 2000 chars) only.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'handled', 'contacted', 'confirmed', 'declined']
        && (!('adminNotes' in request.resource.data)
            || (request.resource.data.adminNotes is string && request.resource.data.adminNotes.size() <= 2000))
        && stampOk(request.resource.data);
      allow create: if validContactMessage(request.resource.data)
        && getAfter(/databases/$(database)/documents/meta/contact_rate).data.lastAt == request.time
        && getAfter(/databases/$(database)/documents/meta/contact_rate).data.get('lastMsgId', '') == id;
    }

    // ------------------- contact categories (ADR-028) -------------------
    function contactSlots() {
      return ['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10', 'c11', 'c12'];
    }

    // Used while settings/contact does not exist (= ContactSettings.defaults
    // in lib/domain/contact_categories.dart; only kind / on / anon matter here).
    function defaultContactCats() {
      return {
        'c1': 'general\u001f1\u001f0\u001f10\u001fاستفسار عام\u001fGeneral inquiry\u001f',
        'c2': 'booking\u001f1\u001f0\u001f20\u001fحجز قاعة\u001fHall booking\u001fwedding|فرح|Wedding\u001econdolence|عزاء|Condolence',
        'c3': 'complaint\u001f1\u001f1\u001f30\u001fشكوى\u001fComplaint\u001f',
        'c4': 'suggestion\u001f1\u001f1\u001f40\u001fاقتراح\u001fSuggestion\u001f'
      };
    }

    // The category string stored in slot [slot] (null = none).
    function contactCat(slot) {
      return exists(/databases/$(database)/documents/settings/contact)
        ? get(/databases/$(database)/documents/settings/contact).data.get('categories', {}).get(slot, null)
        : defaultContactCats().get(slot, null);
    }

    // settings/contact: categories {c1…c12: one string each}; at least one.
    // Only the slots a write adds or changes are validated.
    function validContactSettings(d) {
      let old = resource == null ? {} : resource.data.get('categories', {});
      return keysAllowed(['categories', 'updatedAt', 'updatedBy'])
        && d.categories is map && d.categories.size() >= 1 && d.categories.keys().hasOnly(contactSlots())
        && validContactCats(d.categories, d.categories.diff(old is map ? old : {}).affectedKeys())
        && stampOk(d);
    }

    function validContactCats(c, ch) {
      return (!ch.hasAny(['c1']) || !('c1' in c) || validContactCat(c.c1))
        && (!ch.hasAny(['c2']) || !('c2' in c) || validContactCat(c.c2))
        && (!ch.hasAny(['c3']) || !('c3' in c) || validContactCat(c.c3))
        && (!ch.hasAny(['c4']) || !('c4' in c) || validContactCat(c.c4))
        && (!ch.hasAny(['c5']) || !('c5' in c) || validContactCat(c.c5))
        && (!ch.hasAny(['c6']) || !('c6' in c) || validContactCat(c.c6))
        && (!ch.hasAny(['c7']) || !('c7' in c) || validContactCat(c.c7))
        && (!ch.hasAny(['c8']) || !('c8' in c) || validContactCat(c.c8))
        && (!ch.hasAny(['c9']) || !('c9' in c) || validContactCat(c.c9))
        && (!ch.hasAny(['c10']) || !('c10' in c) || validContactCat(c.c10))
        && (!ch.hasAny(['c11']) || !('c11' in c) || validContactCat(c.c11))
        && (!ch.hasAny(['c12']) || !('c12' in c) || validContactCat(c.c12));
    }

    // One category, ONE string (ContactCategory.encode):
    //   kind␟on␟anon␟order␟labelAr␟labelEn␟subtypes
    // kind general / booking / complaint / suggestion; on, anon 1 / 0 (anon
    // only for complaint / suggestion); order an integer; labels: Arabic
    // 1..80 and not blank, English <= 80; up to 8 subtypes
    // 'key|labelAr|labelEn' joined by U+001E (key [a-z0-9_-]{1,30}, Arabic
    // label 1..60 and not blank, English <= 60).
    function validContactCat(c) {
      return c is string
        && c.matches('((general|booking)\\x1f[01]\\x1f0|(complaint|suggestion)\\x1f[01]\\x1f[01])\\x1f-?[0-9]{1,6}\\x1f[^\\x1f]*[^\\s\\x1f][^\\x1f]*\\x1f[^\\x1f]*\\x1f(|[a-z0-9_-]{1,30}[|][^|\\x1e\\x1f]*[^|\\s\\x1e\\x1f][^|\\x1e\\x1f]*[|][^|\\x1e\\x1f]*(\\x1e[a-z0-9_-]{1,30}[|][^|\\x1e\\x1f]*[^|\\s\\x1e\\x1f][^|\\x1e\\x1f]*[|][^|\\x1e\\x1f]*){0,7})')
        && c.matches('[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]*\\x1f[^\\x1f]{1,80}\\x1f[^\\x1f]{0,80}\\x1f(|[^|\\x1e\\x1f]*[|][^|\\x1e\\x1f]{1,60}[|][^|\\x1e\\x1f]{0,60}(\\x1e[^|\\x1e\\x1f]*[|][^|\\x1e\\x1f]{1,60}[|][^|\\x1e\\x1f]{0,60}){0,7})');
    }

    // A public contact message. Legacy shape (no category): name + phone or
    // email, as before. With a category (ADR-028): the slot must exist and be
    // switched on and `kind` must match it; bookings need a phone and a
    // preferred date (YYYY-MM-DD) and may name a subtype key; an anonymous
    // message (only for a category that allows it, complaint / suggestion)
    // carries NO name, phone or email key at all.
    function validContactMessage(d) {
      let cat = ('category' in d && d.category is string && d.category in contactSlots()) ? contactCat(d.category) : null;
      return d.keys().hasOnly(['name', 'phone', 'email', 'message', 'lang', 'status', 'createdAt', 'category', 'kind',
                               'anonymous', 'bookingType', 'preferredDate'])
        && d.keys().hasAll(['message', 'status', 'createdAt'])
        && d.message is string && d.message.size() >= 5 && d.message.size() <= 1000
        && d.message.matches('[\\s\\S]*\\S[\\s\\S]*')
        && (!('lang' in d) || d.lang in ['ar', 'en'])
        && d.status == 'new'
        && d.createdAt == request.time
        && (('category' in d)
              ? (cat is string && 'kind' in d && d.kind in ['general', 'booking', 'complaint', 'suggestion']
                 && cat.matches(d.kind + '\\x1f1\\x1f[\\s\\S]*'))
              : !d.keys().hasAny(['kind', 'anonymous', 'bookingType', 'preferredDate']))
        && d.get('anonymous', false) is bool
        && (d.get('anonymous', false) == true
              ? (!d.keys().hasAny(['name', 'phone', 'email', 'bookingType', 'preferredDate'])
                 && cat is string && cat.matches('(complaint|suggestion)\\x1f1\\x1f1\\x1f[\\s\\S]*'))
              : validIdentifiedMessage(d));
    }

    function validIdentifiedMessage(d) {
      return 'name' in d
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.name.matches('[\\s\\S]*\\S[\\s\\S]*') // not whitespace-only
        && (!('phone' in d) || (d.phone is string && (d.phone == '' || d.phone.matches('^[0-9+]{5,15}$'))))
        && (!('email' in d) || (d.email is string && d.email.size() <= 254
              && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))))
        // at least one way to reach the sender
        && ((('phone' in d) && d.phone != '') || (('email' in d) && d.email != ''))
        && (d.get('kind', 'general') == 'booking'
              ? (('phone' in d) && d.phone != ''
                 && d.get('preferredDate', '') is string
                 && d.get('preferredDate', '').matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
                 && (!('bookingType' in d) || (d.bookingType is string && d.bookingType.matches('[a-z0-9_-]{1,30}'))))
              : !d.keys().hasAny(['bookingType', 'preferredDate']));
    }
  }
}
