# .agents/workflow.env — per-project settings for the hark-workflow kit (read by hw.mjs and the hooks; never executed).
# Syntax: KEY="value" (one per line). Commit it: it holds no secrets.

PROJECT_NAME="my-project"
GITHUB_REPO="owner/repo"              # default: parsed from the origin remote
DEFAULT_BRANCH="main"
PROTECTED_BRANCHES="main"             # pushes to these are blocked by the git-safety hook
STACK="auto"                          # auto | flutter | flutter-firebase | node | python | custom
OWNER_LANGUAGE="en"                   # language of every message to the owner (e.g. ar)
TIMEZONE="UTC"                        # IANA zone for STATUS log times (e.g. Africa/Cairo)
STATUS_DIR=".work"                    # STATUS files: <STATUS_DIR>/<topic>/STATUS.md (git-ignored)
WORKTREE_ROOT="../worktrees"          # where hw-worktree creates one worktree per PR (relative to the repo)

# Local gate (hw.mjs gate). Empty = stack default; "off" = skip. {python} = python3/python/py -3 found at run time.
GATE_ENV_SCRIPT=""                    # optional POSIX env file sourced before every gate step (e.g. a Flutter PATH setup); skipped when missing or on Windows
GATE_SETUP=""                         # e.g. flutter pub get
GATE_ANALYZE=""                       # e.g. flutter analyze
GATE_TEST=""                          # e.g. flutter test
GATE_SEED=""                          # regenerate generated files and fail on diff
GATE_RULES=""                         # security-rules emulator tests
RULES_TEST_DIR=""                     # folder of the rules test package (default tool/rules_test; default GATE_RULES = npm ci + npm test there)
GATE_BUILD=""                         # release build
GATE_POST_BUILD=""                    # e.g. fingerprinting
GATE_EXTRA=""                         # more commands separated by ;;

# Size budget (hw.mjs size)
SIZE_FILE=""                          # e.g. build/web/main.dart.js
SIZE_BASELINE_RAW=""                  # bytes on the base commit
SIZE_BASELINE_GZ=""                   # gzip -9 bytes on the base commit
SIZE_BASELINE_REF=""                  # e.g. main@7e4705b
SIZE_BUDGET_GZ=""                     # max allowed gzip growth in bytes

# CI, deploy, live
CI_WORKFLOW="CI"
DEPLOY_WORKFLOW="Deploy"              # exact `name:` of the workflow that deploys on push to DEFAULT_BRANCH
CI_IGNORE_CHECKS=""                   # regex of check names to ignore (apps that never finish)
LIVE_URL=""
LIVE_PATHS="/"
BUNDLE_PATH=""                        # e.g. main.dart.js
PREVIEW_URL_PATTERN=""                # e.g. https://<site>--pr-{n}-*.web.app (the bot comment has the exact URL)
DEV_BRANCH=""                         # e.g. dev (a branch that deploys a staging channel)
DEV_WORKFLOW=""                       # FILE name of the dev deploy workflow, e.g. deploy-dev.yml (hw.mjs dispatch / wait-run / dev-channel-url)
HOSTING_CHANNEL=""                    # Firebase Hosting channel the dev workflow deploys, e.g. dev (URL site--<channel>-<hash>.web.app)
DEV_URL=""                            # current dev channel URL (dev-channel-url compares against it)
PSI_BASELINE_MOBILE=""                # perf/a11y/best/seo, e.g. 61/100/100/100
PSI_BASELINE_DESKTOP=""

# Sentry (hw.mjs sentry-issues). The token is NEVER stored here: export SENTRY_TOKEN in the shell / CI secrets.
SENTRY_ORG=""                         # organization slug
SENTRY_PROJECT=""                     # project slug
SENTRY_ENVIRONMENT="production"       # environment to check after a deploy
SENTRY_HOST="https://sentry.io"       # EU region: https://de.sentry.io

# Reviews
REVIEW_BOTS="coderabbitai sentry"     # each gets "@<bot> review"
REVIEW_MAX_ROUNDS="2"
REVIEW_STALL_MINUTES="10"

# Docs
MEMORY_BANK_DIR="docs/memory-bank"
DOCS_DIR="documentation"
DOCS_LANGUAGE="en"
ADR_FILE="docs/memory-bank/10-decisions-and-history.md"   # one file holding every ADR block
# ADR_DIR="docs/adr"                  # OR one file per ADR (used by adr-next only when ADR_FILE does not exist)
OPEN_TASKS_FILE="docs/memory-bank/11-open-tasks.md"
PLANS_DIR="docs/plans"

# Safety
DESTRUCTIVE_PATTERNS=""               # one regular expression of extra commands the agent may never run
SECRET_PATTERNS=""                    # one regular expression of extra secret formats to block in file writes
# ALLOW_PROTECTED_PUSH_ONCE=1         # ONLY for the very first push of a brand-new empty repo; remove after
