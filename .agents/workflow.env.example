# .agents/workflow.env.example — Kerollosmm/church-portal profile for hark-workflow v2. Copy to .agents/workflow.env (or: node .agents/plugins/hark-workflow/scripts/hw.mjs install profile church-portal . --force).
# Read by hw.mjs and the hooks; never executed. No secrets here (SENTRY_TOKEN / GITHUB_TOKEN live in the environment).
# Facts checked on 7 Nov 2026 against main@7e4705b, the dev branch and docs/plans/phase2/HANDOFF.md.

PROJECT_NAME="church-portal"
GITHUB_REPO="Kerollosmm/church-portal"
DEFAULT_BRANCH="main"
PROTECTED_BRANCHES="main"
STACK="flutter-firebase"
OWNER_LANGUAGE="ar"                      # every message to the owner in Arabic
TIMEZONE="Africa/Cairo"                  # STATUS times, deadlines, reports (absolute dates only)
STATUS_DIR=".work"
WORKTREE_ROOT=".work/wt"

# ---------- Local gate (hw.mjs gate) — the same steps as ci.yml ----------
# Hark sandbox: Flutter lives in /workspace/tools (PATH + PUB_CACHE + local storage mirror). On the owner's PC the file
# does not exist, the gate says "skipped" and Flutter / Node / Java come from PATH (Flutter stable, Node 22, Java 21).
GATE_ENV_SCRIPT="/workspace/tools/flutter_env.sh"
GATE_SETUP="flutter pub get"
GATE_ANALYZE="flutter analyze"
GATE_TEST="flutter test --no-pub"        # hw.mjs adds NO_PROXY=127.0.0.1,localhost (needed behind a proxy)
GATE_SEED="{python} tool/gen_seed.py && git diff --exit-code -- assets/seed/seed.json tool/known_seed_ids.json tool/retired_seed_ids.json"
RULES_TEST_DIR="tool/rules_test"
GATE_RULES="cd tool/rules_test && npm ci --no-audit --no-fund && npm test"   # Firestore emulator, Java 11+ (CI: 21)
GATE_BUILD="flutter build web --release"
GATE_POST_BUILD="{python} tool/fingerprint_icon_fonts.py build/web"
# extra-1: seed.json is valid JSON · extra-2: nothing forbidden is tracked (rules_test node_modules, *-debug.log)
GATE_EXTRA="node -e \"JSON.parse(require('fs').readFileSync('assets/seed/seed.json','utf8')); console.log('seed.json OK')\" ;; node -e \"const t=require('child_process').execSync('git ls-files').toString().split('\\n').filter(f=>/(^|\\/)node_modules\\/|-debug\\.log$/.test(f)); if(t.length){console.error('FORBIDDEN tracked files: '+t.join(' ')); process.exit(1)} console.log('no node_modules / *-debug.log tracked')\""

# ---------- Size budget (hw.mjs size) ----------
# Baseline: local release build of main@7e4705b on 6 Nov 2026. Budget: +20 KB gzip per PR, measured against the PR's
# BASE branch (in a stacked chain pass the base PR's numbers: size --baseline-raw <B> --baseline-gz <G>).
# Phase 2 chain total: <= +60 KB gzip over this baseline.
SIZE_FILE="build/web/main.dart.js"
SIZE_BASELINE_RAW="4898252"
SIZE_BASELINE_GZ="1334591"
SIZE_BASELINE_REF="main@7e4705b (local release build, 6 Nov 2026)"
SIZE_BUDGET_GZ="20480"

# ---------- CI, deploy, live ----------
CI_WORKFLOW="CI"                         # ci.yml: analyze, test, build, fingerprint, seed drift + firestore-rules emulator
DEPLOY_WORKFLOW="Deploy to Firebase"     # deploy.yml: build, rules-test, deploy-rules, deploy-live on push to main; preview pr-<n> on PRs
CI_IGNORE_CHECKS=""
LIVE_URL="https://maximos-domadios-church.web.app"
LIVE_PATHS="/ /admin"
BUNDLE_PATH="main.dart.js"
PREVIEW_URL_PATTERN="https://maximos-domadios-church--pr-{n}-*.web.app"   # exact URL (random hash) is in the deploy bot comment
PSI_BASELINE_MOBILE="61/100/100/100"     # perf/a11y/best/seo, median of 3; the live mobile score must not drop below 61
PSI_BASELINE_DESKTOP="60/100/100/100"

# Dev environment: push to dev -> deploy-dev.yml -> rules + indexes to the LIVE project (project-wide!) + Hosting
# channel "dev" (expires 30 days after the latest deploy; a new channel gets a new URL hash).
DEV_BRANCH="dev"
DEV_WORKFLOW="deploy-dev.yml"
HOSTING_CHANNEL="dev"
DEV_URL="https://maximos-domadios-church--dev-7qxh72kj.web.app"

# Sentry (ADR-034): EU region. Environments: production (main), dev (dev channel).
SENTRY_ORG="kerollos-0e"
SENTRY_PROJECT="church-portal"
SENTRY_ENVIRONMENT="production"
SENTRY_HOST="https://de.sentry.io"

# ---------- Reviews ----------
REVIEW_BOTS="coderabbitai sentry"
REVIEW_MAX_ROUNDS="2"
REVIEW_STALL_MINUTES="10"

# ---------- Docs ----------
MEMORY_BANK_DIR="docs/memory-bank"
DOCS_DIR="documentation"                 # Arabic manual (ADR-035); English suite in documentation/en/
DOCS_LANGUAGE="ar"
ADR_FILE="docs/memory-bank/10-decisions-and-history.md"
OPEN_TASKS_FILE="docs/memory-bank/11-open-tasks.md"
PLANS_DIR="docs/plans"

# ---------- Safety ----------
# Live data and live Hosting: any real seed run (not --dry-run), the Seed / Deploy / commemoration workflows by hand,
# publishing a Hosting file, a hand deploy of a channel, or Firestore admin commands. Only the owner runs these.
DESTRUCTIVE_PATTERNS="seed_firestore\.js(?!.*--dry-run)|gh workflow run (\S*[Ss]eed|\S*[Dd]eploy|\S*synaxarium)|publish_hosting_file\.js|hosting:channel:deploy|firebase\s+firestore:"
SECRET_PATTERNS=""
