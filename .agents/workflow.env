# .agents/workflow.env — per-project settings for the hark-workflow plugin.
PROJECT_NAME="church-portal"
GITHUB_REPO="Kerollosmm/church-portal"
DEFAULT_BRANCH="main"
PROTECTED_BRANCHES="main"
STACK="flutter-firebase"

# Live site and deploy
LIVE_URL="https://maximos-domadios-church.web.app"
LIVE_PATHS="/ /mass-schedule /about /clinics /contact /ask /admin"
BUNDLE_PATH="main.dart.js"
DEPLOY_WORKFLOW="Deploy to Firebase"
CI_WORKFLOW="CI"

# Reviews
REVIEW_BOTS="coderabbitai sentry"
REVIEW_STALL_MINUTES=10

# Docs
MEMORY_BANK_DIR="docs/memory-bank"
DOCS_DIR="documentation"
DOCS_LANGUAGE="ar"
ADR_FILE="docs/memory-bank/10-decisions-and-history.md"
OPEN_TASKS_FILE="docs/memory-bank/11-open-tasks.md"
STATUS_DIR=".work"

# Local gate
RULES_TEST_DIR="tool/rules_test"
FINGERPRINT_CMD="python3 tool/fingerprint_icon_fonts.py build/web"
SEED_CHECK_CMD="python3 tool/gen_seed.py && git diff --exit-code -- assets/seed/seed.json tool/retired_seed_ids.json tool/known_seed_ids.json"
BUILD_CMD="flutter build web --release"
VERIFY_EXTRA="node -e \"JSON.parse(require('fs').readFileSync('assets/seed/seed.json','utf8')); console.log('seed.json OK')\""
COMMIT_GATE="quick"

# Destructive safety patterns
DESTRUCTIVE_PATTERNS="seed_firestore\.js(?!.*--dry-run)|gh workflow run [Ss]eed"
